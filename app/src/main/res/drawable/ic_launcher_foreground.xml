<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle glow behind the file icon -->
    <path android:pathData="M54,36 m-18,0 a18,18 0 1,1 36,0 a18,18 0 1,1 -36,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="54"
                android:gradientRadius="18"
                android:type="radial">
                <item
                    android:color="#4000E5FF"
                    android:offset="0.0" />
                <item
                    android:color="#00000000"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Rays emanating from behind the file icon -->
    <path
        android:pathData="M54,36 L54,16"
        android:strokeWidth="0.6"
        android:strokeColor="#30FFD54F" />
    <path
        android:pathData="M54,36 L40,18"
        android:strokeWidth="0.5"
        android:strokeColor="#25FFD54F" />
    <path
        android:pathData="M54,36 L68,18"
        android:strokeWidth="0.5"
        android:strokeColor="#25FFD54F" />
    <path
        android:pathData="M54,36 L34,24"
        android:strokeWidth="0.4"
        android:strokeColor="#1AFFD54F" />
    <path
        android:pathData="M54,36 L74,24"
        android:strokeWidth="0.4"
        android:strokeColor="#1AFFD54F" />

    <!-- Triangle frame (Masonic eye triangle) -->
    <path
        android:pathData="M54,22 L38,50 L70,50 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#80FFD54F"
        android:fillColor="#00000000" />

    <!-- Retro file icon body -->
    <path
        android:pathData="M47,28 L57,28 L63,34 L63,48 L47,48 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- File icon dog-ear fold -->
    <path
        android:pathData="M57,28 L57,34 L63,34 Z"
        android:fillColor="#FFC8C8E0" />

    <!-- File icon content lines (retro text editor style) -->
    <path
        android:pathData="M50,37 L60,37"
        android:strokeWidth="1.2"
        android:strokeColor="#FF00E5FF" />
    <path
        android:pathData="M50,40 L58,40"
        android:strokeWidth="1.2"
        android:strokeColor="#FF7C4DFF" />
    <path
        android:pathData="M50,43 L56,43"
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFAB40" />

    <!-- Pyramid step 1 (base, widest) -->
    <path
        android:pathData="M26,78 L82,78 L82,82 L26,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="78"
                android:endX="82"
                android:endY="78"
                android:type="linear">
                <item
                    android:color="#FF00BFA5"
                    android:offset="0.0" />
                <item
                    android:color="#FF00E5FF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pyramid step 2 -->
    <path
        android:pathData="M30,73 L78,73 L78,78 L30,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="73"
                android:endX="78"
                android:endY="73"
                android:type="linear">
                <item
                    android:color="#FF00B8D4"
                    android:offset="0.0" />
                <item
                    android:color="#FF448AFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pyramid step 3 -->
    <path
        android:pathData="M34,68 L74,68 L74,73 L34,73 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="68"
                android:endX="74"
                android:endY="68"
                android:type="linear">
                <item
                    android:color="#FF2979FF"
                    android:offset="0.0" />
                <item
                    android:color="#FF651FFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pyramid step 4 -->
    <path
        android:pathData="M38,63 L70,63 L70,68 L38,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="63"
                android:endX="70"
                android:endY="63"
                android:type="linear">
                <item
                    android:color="#FF651FFF"
                    android:offset="0.0" />
                <item
                    android:color="#FFAA00FF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pyramid step 5 (top, narrowest) -->
    <path
        android:pathData="M42,58 L66,58 L66,63 L42,63 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="58"
                android:endX="66"
                android:endY="58"
                android:type="linear">
                <item
                    android:color="#FFAA00FF"
                    android:offset="0.0" />
                <item
                    android:color="#FFE040FB"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
